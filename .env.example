# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (Neon, Supabase, local, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/speak_up_gen

# Google OAuth (optional until configured)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true only when Google client ID/secret above are set (controls UI button)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudinary (member photos + ID card assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# After migrate + sign-up, promote yourself:
# bun scripts/seed-admin.ts you@example.com
